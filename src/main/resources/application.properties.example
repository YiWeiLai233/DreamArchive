# ============================================================
# DreamArchive - application.properties 配置模板
# 复制本文件为 application.properties 并填入实际值：
#   cp application.properties.example application.properties
# ============================================================

spring.application.name=DreamArchive

# ==================== CORS 跨域 ====================
# 允许的前端来源，多个用逗号分隔；部署时必须加服务器公网 IP
app.cors.allowed-origin-patterns=http://localhost:*,http://127.0.0.1:*
app.cors.allowed-methods=GET,POST,PUT,DELETE,PATCH,OPTIONS
app.cors.allowed-headers=Authorization,Content-Type,Accept,Origin,X-Requested-With,X-XSRF-TOKEN
app.cors.exposed-headers=Authorization
app.cors.allow-credentials=true
app.cors.max-age=3600

# ==================== 认证 ====================
# Token 有效期（秒），默认 86400（24 小时）
app.auth.ttl-seconds=86400
# Token 签名密钥，必须 >= 32 字符，生产环境务必修改
app.auth.secret=你的Token签名密钥至少32字符
# HttpOnly Cookie 认证配置
app.auth.cookie-name=dream_archive_token
# 生产 HTTPS 部署必须设为 true；本地 http 开发可设为 false
app.auth.cookie-secure=false
app.auth.cookie-same-site=Lax
app.auth.csrf-cookie-name=XSRF-TOKEN
app.auth.csrf-header-name=X-XSRF-TOKEN
app.auth.csrf-enabled=true

# ==================== 数据库 ====================
spring.datasource.url=jdbc:mysql://你的数据库地址:3306/dream?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
spring.datasource.username=你的数据库用户名
spring.datasource.password=你的数据库密码
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# ==================== MyBatis ====================
mybatis.type-aliases-package=com.yiweilai.DreamArchive.DTO.Dream
mybatis.mapper-locations=classpath:mapper/*.xml
mybatis.configuration.map-underscore-to-camel-case=true

# ==================== Redis ====================
spring.data.redis.host=你的Redis地址
spring.data.redis.port=6379
spring.data.redis.database=0
# 如果 Redis 设置了密码，取消注释下面一行
# spring.data.redis.password=你的Redis密码

# ==================== 邮件 (QQ邮箱 SMTP) ====================
spring.mail.host=smtp.qq.com
spring.mail.port=587
spring.mail.username=你的QQ邮箱@qq.com
spring.mail.password=你的SMTP授权码
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# ==================== 文件上传 ====================
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=10MB

# ==================== MinIO 对象存储 ====================
minio.endpoint=http://你的MinIO地址:9000
minio.access-key=你的MinIO_ACCESS_KEY
minio.secret-key=你的MinIO_SECRET_KEY
minio.bucket=dream-archive

# ==================== AI 资源池 ====================
# Provider 0 - 主力模型
ai.pool.providers[0].name=mimo
ai.pool.providers[0].url=https://token-plan-cn.xiaomimimo.com/v1
ai.pool.providers[0].apiKey=你的API密钥
ai.pool.providers[0].model=mimo-v2.5-pro
ai.pool.providers[0].weight=50
ai.pool.providers[0].enabled=true

# Provider 1 - 备用模型 / 图片分析专用
ai.pool.providers[1].name=mimo2
ai.pool.providers[1].url=https://token-plan-cn.xiaomimimo.com/v1
ai.pool.providers[1].apiKey=你的API密钥
ai.pool.providers[1].model=mimo-v2.5
ai.pool.providers[1].weight=60
ai.pool.providers[1].enabled=true

# 图片分析使用的 provider 名称
ai.pool.vision-provider=mimo2

# AI 资源池启动心跳：true=启动后异步自检并测速；false=跳过自检，适合本地频繁重启时节省 token
ai.pool.heartbeat.enabled=true
# 单个 provider 心跳请求超时时间（秒）
ai.pool.heartbeat.timeout-seconds=10

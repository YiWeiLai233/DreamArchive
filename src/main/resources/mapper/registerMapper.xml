<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yiweilai.DreamArchive.mapper.RegisterMapper">

    <!-- 注册用户 -->

    <insert id="newUser" parameterType="com.yiweilai.DreamArchive.DTO.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user(username,password,email,created_at)
        VALUES (#{username}, #{password}, #{email}, NOW())
    </insert>


    <!-- 判断用户是否存在 -->

</mapper>

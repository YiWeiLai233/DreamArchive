<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yiweilai.DreamArchive.mapper.resetPasswordMapper">
    <update id="resetByUsername" parameterType="com.yiweilai.DreamArchive.DTO.User">
        UPDATE user
        SET password =  #{newPassword}
        WHERE username=#{Username};

    </update>
    <update id="resetByEmail" parameterType="com.yiweilai.DreamArchive.DTO.User">
        UPDATE user
        SET password =  #{newPassword}
        WHERE email=#{email};
    </update>
</mapper>

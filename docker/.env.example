# DreamArchive Docker 环境变量模板
# 复制为 .env 并填写真实值：cp .env.example .env

# MySQL root 密码
MYSQL_ROOT_PASSWORD=your_mysql_password

# Redis 密码
REDIS_PASSWORD=your_redis_password

# MinIO 对象存储
MINIO_ROOT_USER=dream_minio_admin
MINIO_ROOT_PASSWORD=your_minio_password
MINIO_PUBLIC_ENDPOINT=http://your-server-ip:9000
# QQ 邮箱
MAIL_USERNAME=your_qq_email@qq.com
MAIL_PASSWORD=your_smtp_auth_code

# JWT 认证密钥（建议 32 位以上随机字符串）
AUTH_SECRET=your_auth_secret_change_me

# AI Provider API Key
AI_API_KEY=your_ai_api_key
